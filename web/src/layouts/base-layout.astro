---
import BaseHead from '@/components/base-head.astro'
import Footer from '@/components/footer.astro'
import Header from '@/components/header.astro'
import LanguageRedirect from '@/components/language-redirect.astro'
import type { LanguageKeys } from '@/i18n'

interface Props {
  title: string
  description: string
  lang?: LanguageKeys
  includeLanguageRedirect?: boolean
}

const { title, description, lang = 'en', includeLanguageRedirect = false } = Astro.props
---

<!doctype html>
<html lang={lang}>
  <head>
    <BaseHead title={title} description={description} />
  </head>
  <body>
    {includeLanguageRedirect && <LanguageRedirect />}
    <Header lang={lang} />
    <main>
      <slot />
    </main>
    <Footer lang={lang} />
    <script>
      import Lenis from 'lenis'

      const lenis = new Lenis({
        anchors: true,
        autoRaf: true,
        wheelMultiplier: 0.8,
      })

      // Stashed by the inline script in base-head.astro.
      const { hash } = document.documentElement.dataset

      if (hash) {
        delete document.documentElement.dataset.hash
        lenis.scrollTo(hash)
        history.replaceState(null, '', `${window.location.pathname}${window.location.search}${hash}`)
      }
    </script>
  </body>
</html>
