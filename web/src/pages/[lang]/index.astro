---
import { getCollection, getEntry } from 'astro:content'
import About from '@/components/landing/about.astro'
import Events from '@/components/landing/events.astro'
import Hero from '@/components/landing/hero.astro'
import type { LanguageKeys } from '@/i18n'
import BaseLayout from '@/layouts/base-layout.astro'
import { siteConfig } from '@/site.config'

export function getStaticPaths() {
  const { languages } = siteConfig.i18n
  return Object.keys(languages).map((l) => ({
    params: { lang: l as LanguageKeys },
  }))
}

const { lang } = Astro.params
const page = await getEntry('index', lang)
const rawEvents = await getCollection('event', (entry) => entry.id.startsWith(`${lang}`))

const sortedEvents = rawEvents.toSorted(
  (a, b) => Math.max(...a.data.dates.map((d) => d.getTime())) - Math.max(...b.data.dates.map((d) => d.getTime())),
)

const now = new Date()
now.setHours(0, 0, 0, 0)
const nowTime = now.getTime()

// Detect the first upcoming event (max date >= today)
const upcomingEvent = sortedEvents.find((e) => Math.max(...e.data.dates.map((d) => d.getTime())) >= nowTime)

// Events list for the #events section (exclude the featured upcoming event)
const events = sortedEvents.filter((e) => e.id !== upcomingEvent?.id)

if (!page) {
  throw new Error('Could not find page')
}
---

<BaseLayout title={page.data.title} description={page.data.description} lang={lang}>
  <Hero page={page} upcomingEvent={upcomingEvent} lang={lang} />
  <About page={page} lang={lang} />
  <Events events={events} lang={lang} />
</BaseLayout>
