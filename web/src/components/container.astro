---
import type { HTMLAttributes } from 'astro/types'
import { cn } from 'cn'

interface Props extends HTMLAttributes<'div'> {
  grid?: boolean
  strategy?: 'margin' | 'padding'
}

const { class: className, grid = false, strategy = 'padding', ...rest } = Astro.props
---

<div class="mx-auto w-full max-w-[90rem]" {...rest}>
  <div
    class={cn(
      {
        'grid grid-cols-12 gap-6': grid,
        'px-6 md:px-12 lg:px-20 xl:px-32': strategy === 'padding',
        'mx-6 md:mx-12 lg:mx-20 xl:mx-32': strategy === 'margin',
      },
      className
    )}
  >
    <slot />
  </div>
</div>
