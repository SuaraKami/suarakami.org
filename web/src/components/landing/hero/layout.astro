---
import Container from '@/components/container.astro'

export interface HeroFact {
  label: string
  value: string
}

interface Props {
  description: string
  eyebrow?: string
  facts?: HeroFact[]
  link?: { label: string; target: string; to: string }
  title: string
}

const { description, eyebrow, facts = [], link, title } = Astro.props
---

<section id="hero" class="overflow-hidden bg-background">
  <Container grid class="gap-y-0 pt-16 pb-24 md:pt-24 md:pb-32 lg:pt-32 lg:pb-40">
    {
      eyebrow && (
        <p class="col-span-12 mb-10 text-xs font-medium tracking-[0.18em] text-foreground/40 uppercase md:mb-14">
          {eyebrow}
        </p>
      )
    }

    <h1
      class="col-span-12 max-w-[18ch] text-[clamp(2.5rem,7vw,6.5rem)] leading-[0.98] font-normal
             tracking-[-0.03em] text-balance lg:col-span-11"
    >
      {title}
    </h1>

    <div
      class="col-span-12 mt-16 grid grid-cols-12 gap-x-6 gap-y-12 border-t
             border-foreground/15 pt-8 md:mt-24 md:pt-10"
    >
      {
        facts.length > 0 && (
          <dl class="col-span-12 grid grid-cols-2 gap-x-6 gap-y-8 md:col-span-4 md:grid-cols-1 md:gap-y-8">
            {facts.map((fact, i) => (
              <div>
                <dt class="text-xs font-medium tracking-[0.18em] text-foreground/40 uppercase">
                  {fact.label}
                </dt>
                <dd
                  class:list={[
                    'mt-2 text-lg leading-snug tracking-tight tabular-nums md:text-xl',
                    i === facts.length - 1 && 'md:cap-trim-both md:mt-3',
                  ]}
                >
                  {fact.value}
                </dd>
              </div>
            ))}
          </dl>
        )
      }

      <div class="col-span-12 md:col-span-7 md:col-start-6 md:flex md:flex-col md:justify-between">
        <p class="max-w-[42ch] text-xl leading-snug tracking-tight text-pretty text-foreground/70 md:text-2xl">
          {description}
        </p>

        {
          link && (
            <a
              href={link.to}
              target={link.target}
              rel={link.target === '_blank' ? 'noopener noreferrer' : undefined}
              class="mt-10 inline-flex min-h-11 items-center self-start gap-4 border border-foreground
                     bg-foreground px-8 py-3 text-xs font-medium tracking-[0.16em] text-background
                     uppercase transition-colors hover:bg-background hover:text-foreground
                     focus-visible:ring-2 focus-visible:ring-foreground focus-visible:ring-offset-2
                     focus-visible:ring-offset-background focus-visible:outline-none md:mt-12"
            >
              {link.label}
              <span class="h-px w-6 bg-current" aria-hidden="true" />
            </a>
          )
        }
      </div>
    </div>
  </Container>
</section>
