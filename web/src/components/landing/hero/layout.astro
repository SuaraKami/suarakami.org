---
import Container from '@/components/container.astro'

export interface HeroFact {
  label: string
  value: string
}

interface Props {
  description: string
  eyebrow?: string
  facts?: HeroFact[]
  link?: { label: string; target: string; to: string }
  title: string
}

const { description, eyebrow, facts = [], link, title } = Astro.props
---

<section id="hero" class="overflow-hidden bg-background">
  <Container grid class="gap-y-0 pt-20 pb-24 md:pt-28 md:pb-32 lg:pt-32 lg:pb-40">
    {
      eyebrow && (
        <div
          class="col-span-12 mb-10 flex items-center gap-4 md:mb-14"
        >
          <span class="size-2 shrink-0 bg-foreground" aria-hidden="true" />
          <span class="text-[0.6875rem] font-medium uppercase tracking-[0.18em] text-foreground/45">
            {eyebrow}
          </span>
          <span class="h-px flex-1 bg-foreground/15" aria-hidden="true" />
        </div>
      )
    }

    <h1
      class="col-span-12 text-[clamp(2.75rem,11vw,9.5rem)] leading-[0.88] font-bold
             tracking-[-0.035em] text-balance"
    >
      {title}
    </h1>

    <div
      class="col-span-12 mt-12 grid grid-cols-12 gap-x-6 gap-y-10 border-t
             border-foreground/15 pt-8 md:mt-16 md:pt-10"
    >
      {
        facts.length > 0 && (
          <dl class="col-span-12 flex flex-wrap gap-x-12 gap-y-6 md:col-span-4 md:flex-col md:gap-y-7">
            {facts.map((fact) => (
              <div>
                <dt class="text-[0.6875rem] font-medium uppercase tracking-[0.18em] text-foreground/45">
                  {fact.label}
                </dt>
                <dd class="mt-1.5 text-base font-medium tracking-tight tabular-nums md:text-lg">
                  {fact.value}
                </dd>
              </div>
            ))}
          </dl>
        )
      }

      <div class="col-span-12 md:col-span-7 md:col-start-6">
        <p class="max-w-[48ch] text-xl leading-snug font-medium tracking-tight text-pretty md:text-2xl lg:text-[1.75rem]">
          {description}
        </p>

        {
          link && (
            <a
              href={link.to}
              target={link.target}
              rel="noopener noreferrer"
              class="mt-10 inline-flex items-center gap-4 border border-foreground
                     bg-foreground px-8 py-4 text-[0.8125rem] font-semibold tracking-[0.14em]
                     text-background uppercase hover:bg-background hover:text-foreground md:mt-12"
            >
              {link.label}
              <span class="h-px w-6 bg-current" aria-hidden="true" />
            </a>
          )
        }
      </div>
    </div>
  </Container>
</section>
