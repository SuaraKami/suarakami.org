---
import type { CollectionEntry } from 'astro:content'
import Container from '@/components/vue/container.vue'
import { useFormatDate } from '@/composables/use-format-date'
import type { LanguageKeys } from '@/i18n'
import { useTranslations } from '@/i18n'
import { siteConfig } from '@/site.config'

interface Props {
  page: CollectionEntry<'index'>
  upcomingEvent?: CollectionEntry<'event'>
  lang: LanguageKeys
}
const { page, upcomingEvent, lang } = Astro.props

const t = useTranslations(lang)

const eventData = upcomingEvent?.data
const isUpcomingEvent = !!upcomingEvent

const title = eventData?.title || page.data.hero.title || ''
const description = eventData?.description || page.data.hero.description

const rawDate = eventData?.dates?.[0] || page.data.hero.date
const hasTime = !!rawDate && (rawDate.getUTCHours() > 0 || rawDate.getUTCMinutes() > 0)

const formattedDate = rawDate
  ? useFormatDate(rawDate, lang, {
      day: 'numeric',
      month: 'short',
      timeZone: siteConfig.timeZone,
      year: 'numeric',
    }).formattedDate.value
  : null

const formattedTime =
  rawDate && hasTime
    ? rawDate.toLocaleTimeString('en-GB', {
        hour: '2-digit',
        hourCycle: 'h23',
        minute: '2-digit',
        timeZone: siteConfig.timeZone,
        timeZoneName: 'short',
      })
    : null

const location = eventData?.location || page.data.hero.location

let linkTo = page.data.hero.link?.to || '#about'
let linkLabel = page.data.hero.link?.label || t('landing.getTickets')
let linkTarget = page.data.hero.link?.target || '_self'

if (eventData?.link) {
  if (eventData.link instanceof Object) {
    linkTo = eventData.link.to
    linkLabel = eventData.link.label || t('landing.getTickets')
    linkTarget = eventData.link.target || '_blank'
  } else {
    linkTo = eventData.link
    linkLabel = t('landing.getTickets')
    linkTarget = '_blank'
  }
}

const facts = [
  { label: t('landing.date'), value: formattedDate },
  { label: t('landing.time'), value: formattedTime },
  { label: t('landing.location'), value: location },
].filter((fact) => !!fact.value)
---

<section id="hero" class="overflow-hidden bg-background">
  <Container grid className="gap-y-0 pt-20 pb-24 md:pt-28 md:pb-32 lg:pt-32 lg:pb-40">
    {
      isUpcomingEvent && (
        <div
          class="col-span-12 mb-10 flex animate-in items-center gap-4 duration-700
                 ease-out fill-mode-both fade-in md:mb-14"
        >
          <span class="size-2 shrink-0 bg-foreground" aria-hidden="true" />
          <span class="text-[0.6875rem] font-medium uppercase tracking-[0.18em] text-foreground/45">{t('landing.upcomingEvent')}</span>
          <span class="h-px flex-1 bg-foreground/15" aria-hidden="true" />
        </div>
      )
    }

    {
      title && (
        <h1
          class="col-span-12 animate-in text-[clamp(2.75rem,11vw,9.5rem)] leading-[0.88]
                 font-bold tracking-[-0.035em] text-balance duration-700 ease-out
                 fill-mode-both fade-in slide-in-from-bottom-4"
        >
          {title}
        </h1>
      )
    }

    <div
      class="col-span-12 mt-12 grid animate-in grid-cols-12 gap-x-6 gap-y-10 border-t
             border-foreground/15 pt-8 delay-150 duration-700 ease-out fill-mode-both
             fade-in slide-in-from-bottom-2 md:mt-16 md:pt-10"
    >
      {
        facts.length > 0 && (
          <dl class="col-span-12 flex flex-wrap gap-x-12 gap-y-6 md:col-span-4 md:flex-col md:gap-y-7">
            {facts.map((fact) => (
              <div>
                <dt class="text-[0.6875rem] font-medium uppercase tracking-[0.18em] text-foreground/45">{fact.label}</dt>
                <dd class="mt-1.5 text-base font-medium tracking-tight tabular-nums md:text-lg">
                  {fact.value}
                </dd>
              </div>
            ))}
          </dl>
        )
      }

      <div class="col-span-12 md:col-span-7 md:col-start-6">
        <p class="max-w-[48ch] text-xl leading-snug font-medium tracking-tight text-pretty md:text-2xl lg:text-[1.75rem]">
          {description}
        </p>

        {
          linkTo && (
            <a
              href={linkTo}
              target={linkTarget}
              rel="noopener noreferrer"
              class="group mt-10 inline-flex items-center gap-4 border border-foreground
                     bg-foreground px-8 py-4 text-[0.8125rem] font-semibold tracking-[0.14em]
                     text-background uppercase transition-colors duration-200 ease-out
                     hover:bg-background hover:text-foreground md:mt-12"
            >
              {linkLabel}
              <span
                class="h-px w-6 bg-current transition-[width] duration-200 ease-out group-hover:w-10"
                aria-hidden="true"
              />
            </a>
          )
        }
      </div>
    </div>
  </Container>
</section>
