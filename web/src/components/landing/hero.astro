---
import type { CollectionEntry } from 'astro:content'

import type { LanguageKeys } from '@/i18n'
import type { EventStats } from '@/lib/events'

import HeroEvent from './hero/event.astro'
import HeroOrganization from './hero/organization.astro'

interface Props {
  page: CollectionEntry<'index'>
  promotedEvent?: CollectionEntry<'event'>
  lang: LanguageKeys
  stats: EventStats
}

const { page, promotedEvent, lang, stats } = Astro.props
---

{
  promotedEvent ? (
    <HeroEvent event={promotedEvent} lang={lang} />
  ) : (
    <HeroOrganization hero={page.data.hero} lang={lang} stats={stats} />
  )
}
