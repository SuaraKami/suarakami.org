---
import type { CollectionEntry } from 'astro:content'
import type { LanguageKeys } from '@/i18n'
import { useTranslations } from '@/i18n'
import Container from '@/components/container.astro'

interface Props {
  page: CollectionEntry<'index'>
  lang: LanguageKeys
}
const { page, lang } = Astro.props

const t = useTranslations(lang)
const [lead, ...paragraphs] = page.data.about.split('\n').filter(Boolean)
---

<section id="about" class="relative bg-surface">
  <Container grid class="gap-y-12 py-24 md:gap-y-16 md:py-32 lg:py-40">
    <h2 class="cap-trim col-span-12 text-xs font-medium tracking-[0.18em] text-foreground/40 uppercase">
      {t('landing.whoWeAre')}
    </h2>
    <p
      class="cap-trim col-span-12 text-3xl leading-tight tracking-tight text-balance md:text-4xl lg:text-5xl xl:text-6xl"
    >
      {lead}
    </p>
    <div class="col-span-12 flex flex-col gap-4 border-t border-foreground/15 pt-8 md:col-span-8 md:col-start-5 lg:col-span-5 lg:col-start-8">
      {
        paragraphs.map((paragraph, i) => (
          <p
            class:list={[
              'text-base leading-relaxed text-pretty text-foreground/70 md:text-lg',
              i > 0 && 'pt-4',
              i === paragraphs.length - 1 && 'cap-trim-both',
            ]}
          >
            {paragraph}
          </p>
        ))
      }
    </div>
  </Container>
</section>

