---
import type { CollectionEntry } from 'astro:content'
import type { LanguageKeys } from '@/i18n'
import { useTranslations } from '@/i18n'
import Container from '@/components/container.astro'

interface Props {
  page: CollectionEntry<'index'>
  lang: LanguageKeys
}
const { page, lang } = Astro.props

const t = useTranslations(lang)
const paragraphs = page.data.about.split('\n').filter(Boolean)
---

<section id="about" class="relative border-t border-foreground/15 bg-background">
  <Container grid class="gap-y-12 py-24 md:gap-y-16 md:py-32 lg:py-40">
    <div class="col-span-12 md:col-span-4 lg:col-span-3">
      <h2 class="cap-trim text-xs font-medium tracking-[0.18em] text-foreground/40 uppercase">
        {t('landing.whoWeAre')}
      </h2>
    </div>
    <div class="col-span-12 space-y-8 md:col-span-8 md:col-start-5 lg:col-span-7 lg:col-start-5">
      {
        paragraphs.map((paragraph, i) => (
          <p
            class={
              i === 0
                ? 'cap-trim text-2xl leading-snug tracking-tight text-balance md:text-3xl lg:text-4xl'
                : 'max-w-[60ch] text-lg leading-relaxed text-pretty text-foreground/70 md:text-xl'
            }
          >
            {paragraph}
          </p>
        ))
      }
    </div>
  </Container>
</section>
