---
import type { CollectionEntry } from 'astro:content'
import AccordionEvents from '@/components/vue/accordion-events.vue'
import Container from '@/components/container.astro'
import type { LanguageKeys } from '@/i18n'
import { useTranslations } from '@/i18n'

interface Props {
  events: CollectionEntry<'event'>[]
  lang: LanguageKeys
}
const { events, lang } = Astro.props

const t = useTranslations(lang)
---

<section id="events" class="relative bg-surface">
  <Container grid class="gap-y-12 py-24 md:gap-y-16 md:py-32 lg:py-40">
    <h2 class="cap-trim col-span-12 text-3xl leading-tight tracking-tight md:text-4xl lg:col-span-7 xl:text-5xl">
      {t('nav.events')}
    </h2>
    <div class="col-span-12">
      <div
        class="hidden grid-cols-12 gap-x-6 border-b border-foreground/15 pb-3 text-xs font-medium tracking-[0.18em] text-foreground/40 uppercase md:grid"
        aria-hidden="true"
      >
        <span class="col-span-1">{t('events.number')}</span>
        <span class="col-span-2">{t('landing.date')}</span>
        <span class="col-span-8">{t('events.event')}</span>
      </div>
      <AccordionEvents items={events} lang={lang} client:visible />
    </div>
  </Container>
</section>
