---
import type { CollectionEntry } from 'astro:content'
import AccordionEvents from '@/components/vue/accordion-events.vue'
import Container from '@/components/container.astro'
import type { LanguageKeys } from '@/i18n'
import { useTranslations } from '@/i18n'

interface Props {
  events: CollectionEntry<'event'>[]
  lang: LanguageKeys
}
const { events, lang } = Astro.props

const t = useTranslations(lang)
---

<section id="events" class="relative bg-background">
  <Container grid class="gap-y-12 py-24 md:gap-y-16 md:py-32 lg:py-40">
    <div class="col-span-12 md:col-span-4 lg:col-span-3">
      <h2 class="cap-trim text-xs font-medium tracking-[0.18em] text-foreground/40 uppercase">
        {t('nav.events')}
      </h2>
    </div>
    <div class="col-span-12 border-t border-foreground/15 pt-4 md:col-span-8 md:col-start-5 lg:col-span-8 lg:col-start-5">
      <AccordionEvents items={events} lang={lang} client:visible />
    </div>
  </Container>
</section>
