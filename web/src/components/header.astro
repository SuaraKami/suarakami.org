---
import type { LanguageKeys } from '@/i18n'
import { localizeHref, getTranslations } from '@/i18n'
import { siteConfig } from '@/site.config'
import Container from './container.astro'
import LanguagePicker from './language-picker.astro'
import Logo from './logo.astro'
import MobileNavigation from './vue/mobile-navigation.vue'

interface Props {
  lang: LanguageKeys
}

const { lang } = Astro.props
const t = getTranslations(lang)

const navItems = siteConfig.navigation.map((link) => ({
  href: localizeHref(link.to, lang),
  label: t(`nav.${link.code}`),
}))
---

<header
  id="site-header"
  class="sticky top-0 z-50 translate-y-0 border-b border-border-dark bg-background transition-[translate,background-color] duration-300 ease-out data-[hidden]:-translate-y-full md:relative md:translate-y-0"
>
  <Container>
    <div class="flex items-center justify-between py-8 md:py-12">
      <Logo lang={lang} />
      <nav class="hidden items-center gap-10 md:flex lg:gap-12">
        {
          navItems.map((item) => (
            <a href={item.href} class="inline-flex min-h-11 items-center text-base tracking-tight underline-offset-4 hover:underline">
              {item.label}
            </a>
          ))
        }
        <LanguagePicker
          lang={lang}
          separator="/"
          class="flex items-center gap-2 border-l border-border-dark pl-6 text-sm uppercase"
          langClass="text-foreground/65 underline-offset-4 hover:underline"
          activeLangClass="text-foreground"
        />
      </nav>
      <MobileNavigation client:media="(width < 48rem)" lang={lang} navItems={navItems}>
        <Logo slot="logo" lang={lang} />
        <LanguagePicker
          slot="languages"
          lang={lang}
          class="flex items-center gap-2 text-lg uppercase"
          langClass="inline-flex min-h-11 min-w-11 items-center justify-center text-foreground/65 underline-offset-4 hover:underline"
          activeLangClass="text-foreground"
        />
      </MobileNavigation>
    </div>
  </Container>
</header>

<script>
  const TOP_THRESHOLD = 100
  const header = document.querySelector('#site-header')
  let lastY = window.scrollY

  // Hides the header while scrolling down on mobile (desktop is pinned via
  // md:translate-y-0).
  window.addEventListener(
    'scroll',
    () => {
      const y = window.scrollY
      header?.toggleAttribute('data-hidden', y > TOP_THRESHOLD && y > lastY)
      lastY = y
    },
    { passive: true }
  )
</script>
